{
  "author": "Jukka Kurkela",
  "bugs": {
    "url": "https://github.com/kurkle/astro-chartjs-editor/issues"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2"
  },
  "description": "Editable Chart.js samples in Astro Markdown",
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@kurkle/configs": "^1.0.1",
    "semantic-release": "^25.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/integration.js",
    "./charts": "./src/charts.js",
    "./client": "./src/client.js",
    "./remark": "./src/remark.js",
    "./sections": "./src/sections.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/kurkle/astro-chartjs-editor#readme",
  "keywords": [
    "astro",
    "astro-integration",
    "chart.js",
    "codemirror",
    "starlight"
  ],
  "license": "MIT",
  "name": "@kurkle/astro-chartjs-editor",
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "chart.js": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurkle/astro-chartjs-editor.git"
  },
  "scripts": {
    "format": "biome check --write",
    "lint": "biome check",
    "pack:check": "npm pack --dry-run",
    "prepare": "git config core.hooksPath .githooks || true",
    "pretest": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\"",
    "test": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout"
  },
  "type": "module",
  "version": "0.0.0-development"
}
